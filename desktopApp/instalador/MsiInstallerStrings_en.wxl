<?xml version="1.0" encoding="utf-8"?>
<!-- O nome é o do arquivo principal do jpackage, de propósito: como arquivo adicional, o WiX
     recebe as culturas pt-BR e en-us juntas e acusa cada texto como duplicado. No lugar do
     principal, o jpackage lê a cultura daqui e usa só pt-BR, que também traduz as telas
     padrão do assistente. -->
<WixLocalization Culture="pt-BR" xmlns="http://schemas.microsoft.com/wix/2006/localization" Codepage="1252">
  <String Id="message.install.dir.exist">A pasta [INSTALLDIR] já existe. Deseja instalar nela mesmo assim?</String>
  <String Id="MainFeatureTitle">Recurso principal</String>
  <String Id="DowngradeErrorMessage">Uma versão mais recente do [ProductName] já está instalada. A instalação será encerrada.</String>
  <String Id="DisallowUpgradeErrorMessage">Uma versão anterior do [ProductName] já está instalada e não pode ser atualizada. A instalação será encerrada.</String>

  <String Id="ShortcutPromptDlg_Title">Instalação do [ProductName]</String>
  <String Id="ShortcutPromptDlgTitle">{\WixUI_Font_Title}Atalhos</String>
  <String Id="ShortcutPromptDlgBannerBitmap">WixUI_Bmp_Banner</String>
  <String Id="ShortcutPromptDlgDescription">Selecione os atalhos que serão criados.</String>
  <String Id="ShortcutPromptDlgDesktopShortcutControlLabel">Criar atalho na área de trabalho</String>
  <String Id="ShortcutPromptDlgStartMenuShortcutControlLabel">Criar atalho no menu Iniciar</String>
  <String Id="InstallDirNotEmptyDlg_Title">Instalação do [ProductName]</String>
  <String Id="ContextMenuCommandLabel">Abrir com [ProductName]</String>

  <String Id="AbrirAposInstalar">Abrir o clickOrçamento agora</String>
</WixLocalization>
